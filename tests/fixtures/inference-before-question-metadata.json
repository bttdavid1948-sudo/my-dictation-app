    {
      "id": "MAN-0565",
      "unitName": "MAN-0565 · Đánh giá bù công bằng",
      "topic": "Học tập",
      "level": "B2",
      "track": "Giao tiếp",
      "learningGoal": "Hiểu lập luận và suy ra quyết định trong thảo luận về đánh giá.",
      "usefulLanguage": [
        "fair comparison",
        "same preparation time"
      ],
      "items": [
        {
          "en": "Several people missed the oral assessment because the campus shuttle stopped without warning. Could we simply add their written scores instead?",
          "vi": "Một số người bỏ lỡ phần đánh giá nói vì xe đưa đón của trường ngừng chạy mà không có báo trước. Chúng ta có thể đơn giản cộng điểm bài viết của họ thay vào đó không?",
          "segmentId": "S001",
          "speakerRole": "student",
          "audio": {
