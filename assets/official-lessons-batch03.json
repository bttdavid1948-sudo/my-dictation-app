            "durationSeconds": 3.75,
            "voice": "marin"
          }
        },
        {
          "en": "Do I look at the picture first?",
          "vi": "Mình xem hình trước à?",
          "segmentId": "S003",
          "speakerRole": "learner",
          "audio": {
            "url": "assets/audio/MAN-0067-S003-batch03-v0.1.wav",
