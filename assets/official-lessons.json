    {
      "unitName": "Đổi lịch hẹn cà phê",
      "topic": "Đời sống",
      "level": "A2",
      "track": "Giao tiếp",
      "learningGoal": "Nghe một cuộc hẹn thay đổi và nắm thời điểm mới.",
      "usefulLanguage": [
        "running late",
        "move it to",
        "works for me"
      ],
      "items": [
        {
          "en": "Are we still meeting for coffee this afternoon?",
          "vi": "Chiều nay mình vẫn gặp nhau uống cà phê chứ?"
        },
        {
          "en": "I am running late because my bus broke down.",
          "vi": "Tôi đến muộn vì xe buýt của tôi bị hỏng."
        },
        {
          "en": "Can we move it to four thirty?",
          "vi": "Mình dời cuộc hẹn sang bốn giờ rưỡi được không?"
        },
        {
          "en": "That works for me, but I have to leave by six.",
          "vi": "Giờ đó được với tôi, nhưng tôi phải về trước sáu giờ."
        },
        {
          "en": "Let's meet outside the small cafe by the park.",
          "vi": "Mình gặp nhau bên ngoài quán cà phê nhỏ cạnh công viên nhé."
        },
        {
          "en": "I'll send you a message when I get there.",
          "vi": "Khi đến nơi tôi sẽ nhắn cho bạn."
        }
      ],
      "id": "man-original-02",
      "publisher": "man",
      "status": "archived",
