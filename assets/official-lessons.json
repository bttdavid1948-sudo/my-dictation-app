    {
      "unitName": "Một chuyến tàu đổi sân ga",
      "topic": "Du lịch",
      "level": "B1",
      "track": "Giao tiếp",
      "learningGoal": "Nghe thông báo thay đổi sân ga và xác định hành động cần làm.",
      "usefulLanguage": [
        "platform change",
        "instead of",
        "keep an eye on"
      ],
      "items": [
        {
          "en": "The platform for our train to the coast has changed.",
          "vi": "Chuyến tàu ra biển của chúng ta đã đổi sân ga."
        },
        {
          "en": "It will leave from platform eight instead of platform three.",
          "vi": "Tàu sẽ khởi hành ở sân ga số tám thay vì sân ga số ba."
        },
        {
          "en": "We have ten minutes, so there is no need to run.",
          "vi": "Chúng ta còn mười phút nên không cần chạy."
        },
        {
          "en": "Let's check the departure board once more.",
          "vi": "Mình kiểm tra bảng giờ tàu thêm một lần nữa nhé."
        },
        {
          "en": "Keep an eye on your bag while we walk through the station.",
          "vi": "Nhớ để mắt đến túi của bạn khi mình đi qua nhà ga."
        },
        {
          "en": "I can carry the small suitcase if your hands are full.",
          "vi": "Nếu tay bạn đang bận, tôi có thể xách chiếc vali nhỏ."
        }
      ],
      "id": "man-original-04",
      "publisher": "man",
