      "id": "MAN-0365",
      "unitName": "MAN-0365 · Vì sao lịch phòng thí nghiệm bị đổi?",
      "topic": "Học tập",
      "level": "B1",
      "track": "Giao tiếp",
      "learningGoal": "Nghe nguyên nhân đổi lịch và trình tự xử lý để hoàn thành các phép đo.",
      "usefulLanguage": [
        "safety inspection",
        "morning slot",
        "measurements"
      ],
      "items": [
        {
          "en": "Our project group booked the science lab for Thursday afternoon. Why was the booking cancelled?",
          "vi": "Nhóm dự án của chúng tôi đã đặt phòng thí nghiệm khoa học vào chiều thứ Năm. Tại sao lịch đặt phòng lại bị hủy?",
          "segmentId": "S001",
          "audio": {
