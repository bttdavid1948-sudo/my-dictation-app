            "releaseClass": "CONTROLLED_INTERNAL_RELEASE",
            "lessonId": "MAN-0365",
            "lessonVersion": "v0.1",
            "segmentId": "S001",
            "realizationId": "MAN-0365-OPENAI-FIXED-v0.2",
