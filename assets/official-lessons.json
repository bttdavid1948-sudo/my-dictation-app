  "lessons": [
    {
      "unitName": "Một buổi sáng bớt vội",
      "topic": "Đời sống",
      "level": "A1",
      "track": "Giao tiếp",
      "learningGoal": "Nghe các câu ngắn về thói quen buổi sáng và nhận diện thời gian.",
      "usefulLanguage": [
        "wake up",
        "have breakfast",
        "leave home"
      ],
      "items": [
        {
          "en": "I wake up at seven on weekdays.",
          "vi": "Tôi thức dậy lúc bảy giờ vào các ngày trong tuần."
        },
        {
          "en": "I open the window and drink some water.",
          "vi": "Tôi mở cửa sổ và uống một ít nước."
        },
        {
          "en": "My sister makes breakfast in the kitchen.",
          "vi": "Chị gái tôi chuẩn bị bữa sáng trong bếp."
        },
        {
          "en": "We eat together before she goes to work.",
          "vi": "Chúng tôi ăn cùng nhau trước khi chị ấy đi làm."
        },
        {
          "en": "I leave home at eight with my bag.",
          "vi": "Tôi rời nhà lúc tám giờ, mang theo túi của mình."
        },
        {
          "en": "The bus stop is near our house.",
          "vi": "Trạm xe buýt ở gần nhà chúng tôi."
        }
      ],
      "id": "man-original-01",
      "publisher": "man",
      "status": "archived",
      "sourceType": "original",
