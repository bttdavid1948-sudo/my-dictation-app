    {
      "unitName": "Giải quyết một đơn hàng lỗi",
      "topic": "Công việc",
      "level": "B1",
      "track": "TOEIC",
      "learningGoal": "Nắm vấn đề, cách xử lý và thời hạn trong một cuộc trao đổi công việc.",
      "usefulLanguage": [
        "missing items",
        "check with",
        "follow up"
      ],
      "items": [
        {
          "en": "A customer called about an order with two missing items.",
          "vi": "Một khách hàng gọi về đơn hàng bị thiếu hai món."
        },
        {
          "en": "I checked the invoice, and both items were listed there.",
          "vi": "Tôi đã kiểm tra hóa đơn và thấy cả hai món đều được ghi trên đó."
        },
        {
          "en": "The warehouse may have packed the wrong box.",
          "vi": "Có thể kho đã đóng nhầm thùng hàng."
        },
        {
          "en": "Could you check with the warehouse team this morning?",
          "vi": "Sáng nay bạn kiểm tra lại với đội kho được không?"
        },
        {
          "en": "I'll call the customer back before lunch.",
          "vi": "Tôi sẽ gọi lại cho khách trước giờ ăn trưa."
        },
        {
          "en": "We should follow up after the replacement is delivered.",
          "vi": "Chúng ta nên hỏi thăm lại sau khi hàng thay thế được giao."
        }
      ],
      "id": "man-original-03",
      "publisher": "man",
      "status": "archived",
