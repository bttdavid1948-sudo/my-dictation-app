            "primaryEndFrame": 726536,
            "contextStartFrame": 552536,
            "contextEndFrame": 750536,
            "sampleRate": 24000
          }
        },
        {
          "en": "Then use the marker in a small follow-up study, rather than changing the treatment protocol for everyone.",
          "vi": "Vậy hãy dùng chỉ dấu này trong một nghiên cứu theo dõi nhỏ, thay vì thay đổi phác đồ điều trị cho tất cả mọi người.",
          "segmentId": "S005",
          "speakerRole": "clinician",
          "audio": {
            "url": "assets/audio/MAN-0844-S005-context-v0.1.wav",
            "releaseClass": "CONTROLLED_INTERNAL_RELEASE",
