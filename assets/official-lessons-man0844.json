            "profileRef": "MAN-0844-MIXED-CONTEXT@v0.1",
            "sha256": "bb42d6d55291273dbe4c36ae86462f99ae97808ef0c5bec7116b5d01fdc82a68",
            "durationSeconds": 10.35,
            "replayEvidence": "CONTEXT_PRESERVING_ASSISTED",
            "primaryStartFrame": 401848,
            "primaryEndFrame": 602248,
            "contextStartFrame": 377848,
            "contextEndFrame": 626248,
            "sampleRate": 24000
          }
        },
        {
          "en": "I am not arguing that we ignore it. I am arguing that the claim should match the strength of the evidence.",
          "vi": "Tôi không đề nghị bỏ qua tín hiệu đó. Tôi cho rằng mức độ khẳng định phải tương xứng với độ mạnh của bằng chứng.",
          "segmentId": "S004",
          "speakerRole": "researcher",
          "audio": {
            "url": "assets/audio/MAN-0844-S004-context-v0.1.wav",
            "releaseClass": "CONTROLLED_INTERNAL_RELEASE",
